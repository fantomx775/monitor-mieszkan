# Local values are generated by scripts/dev-up.ps1 from the Supabase CLI.
# Copying real credentials into this template is not supported.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
WEB_PORT=3000

# Set these only when you want the local demo account to use fixed credentials.
# Otherwise pnpm demo:seed generates a password and writes it to ignored .env.local.
LOCAL_DEMO_EMAIL=
LOCAL_DEMO_PASSWORD=
