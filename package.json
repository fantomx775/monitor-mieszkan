{
  "name": "real-estate-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-up.ps1",
    "dev:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-down.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:rls": "tsx scripts/verify-rls.ts",
    "test:data": "tsx scripts/verify-data-semantics.ts",
    "db:reset": "pnpm exec supabase db reset",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "worker:sync": "tsx scripts/sync.ts",
    "worker:report:daily": "tsx scripts/report-daily.ts",
    "source:verify-live-pass": "tsx scripts/verify-live-pass.ts",
    "sync": "docker compose --env-file .env.local run --rm --build worker worker:sync",
    "sync:source": "docker compose --env-file .env.local run --rm --build worker worker:sync",
    "sync:dry-run": "docker compose --env-file .env.local run --rm --build worker worker:sync --dry-run",
    "report:daily": "docker compose --env-file .env.local run --rm --build worker worker:report:daily"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.12.0",
    "lucide-react": "1.67.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "domhandler": "5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "supabase": "3.0.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.25.0"
}
